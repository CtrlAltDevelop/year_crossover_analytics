  <property name="styleSheet">
   <string notr="true">/* Main Window */
QMainWindow {
	background-color: #f0f0f0;
}


/* Label */
QLabel {
	font-size: 13px;
    font-weight: 600;
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    color: #2d3436;
}


/* Group Box */
QGroupBox {
    font-size: 14px;
    font-weight: 800;
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    color: #2d3436;
    border: 1px solid #b0b5b8;
    border-radius: 6px;
    background-color: #ffffff;
    margin-top: 18px;
    padding: 6px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 5px 8px;
    color: #2d3436;
    left: 10px;
    top: 4px;
}


/* Push Button */
QPushButton {
    background-color: #4CAF50;
    color: #ffffff;
    border: none;
    font-size: 14px;
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    border-radius: 5px;
    padding: 8px 16px;
}

QPushButton:hover {
	background-color: #45a049;
}

QPushButton:pressed {
	background-color: #429746;
}

QPushButton:focus {
    border: 1px solid #54be59;
}


/* Line Edit */
QLineEdit {
	padding: 6px;
    font-size: 14px;
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    border: 1px solid #b0b5b8;
    border-radius: 5px;
    background-color: #ffffff;
    color: #2d3436;
}

QLineEdit:focus {
    border: 1px solid #54be59;
    background-color: #f8fbff;
}


/* Combo Box */
QComboBox {
    border: 1px solid #b0b5b8;
    border-radius: 5px;
    background-color: #ffffff;
    font-size: 14px;
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    color: #2d3436;
    padding: 6px;
}

QComboBox:hover {
    background-color: #f1f3f5;
}

QComboBox:focus {
    border: 1px solid #54be59;
}

QComboBox::drop-down {
    width: 24px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
    /* Optional: Add custom arrow icon in resource file */
    /* image: url(:/icons/down_arrow.png); */
}

QComboBox QAbstractItemView {
    border: 1px solid #b0b5b8;
    border-radius: 5px;
    background-color: #ffffff;
    selection-background-color: #45a049;
    selection-color: #ffffff;
    color: #2d3436;
}

QComboBox QAbstractItemView::item {
    padding: 10px;
    min-height: 28px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #f1f3f5;
    color: #2d3436;
}


/* Progress Bar */
QProgressBar {
	border: 1px solid #ccc;
    border-radius: 4px;
    text-align: center;
    font-size: 14px;
    margin-top: 5px;
}

QProgressBar::chunk {
	background-color: #4CAF50;
    width: 10px;
}


/* Text Edit */
QTextEdit {
    font-size: 14px;
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    border: 1px solid #b0b5b8;
    border-radius: 5px;
    background-color: #ffffff;
    color: #2d3436;
    padding: 6px;
    line-height: 1.5;
}

QTextEdit:hover {
    background-color: #f1f3f5;
}

QTextEdit:focus {
    border: 1px solid #0984e3;
    background-color: #f8fbff;
}


/* Check Box */
QCheckBox {
    font-size: 14px;
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    color: #2d3436;
    spacing: 8px;
padding-left: 20px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #b0b5b8;
    border-radius: 4px;
    background-color: #ffffff;
}

QCheckBox::indicator:unchecked:hover {
    background-color: #f1f3f5;
}

QCheckBox::indicator:checked {
    background-color: #0984e3;
    border: 1px solid #0984e3;
    image: url(:/icons/checkmark.png); /* Optional: Add custom checkmark icon */
}

QCheckBox::indicator:checked:hover {
    background-color: #0871c4;
}

QCheckBox:focus {
    border: none;
    outline: none;
}</string>
